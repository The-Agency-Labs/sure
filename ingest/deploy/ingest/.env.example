# Where this stack lives on the VM (see env.sh for the layout), and the
# host's finance share.
STACK_DIR=/root/sure
FINANCE_DIR=/mnt/finance-data

# Only used when mfa.unattended is "form": the VM's tailnet IP.
MFA_BIND=100.64.0.10

# Browser locale and timezone: match where you actually are, or the bank sees
# a browser whose clock disagrees with its IP.
INGEST_LOCALE=en-US
INGEST_TIMEZONE=America/New_York
