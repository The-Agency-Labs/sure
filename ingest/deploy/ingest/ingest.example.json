{
  "paths": {
    "raw": "/srv/finance/raw",
    "normalized": "/srv/finance/normalized",
    "secrets": "/srv/ingest-secrets",
    "banks": "/opt/ingest/ingest/banks",
    "bundles": "/srv/ingest-state/bundles",
    "review": "/srv/ingest-state/review",
    "repair_queue": "/srv/ingest-state/repair-queue"
  },
  "browser": {
    "channel": "chrome",
    "headless": false,
    "chromium_sandbox": true
  },
  "mfa": {
    "unattended": "stop",
    "bind": "0.0.0.0",
    "port": 8765,
    "public_base": "http://FINANCE_VM_TAILNET_NAME:8765",
    "timeout_s": 300
  },
  "notify": {
    "type": "none",
    "_examples": [
      {"type": "webhook", "url": "http://PUSH_SERVICE/api/notify", "token_file": "/srv/ingest-secrets/notify_token"},
      {"type": "ntfy", "url": "http://NTFY_HOST", "topic": "finance-sync", "token_file": "/srv/ingest-secrets/notify_token"}
    ]
  },
  "sure": {"url": "http://web:3000", "api_key_file": "/run/secrets/sure_api_key"},
  "repair": {
    "url": "http://127.0.0.1:11434",
    "model": "qwen2.5:3b",
    "sensitive_file": "/srv/ingest-secrets/sensitive.json"
  },
  "accounts": {
    "_format": "<institution>:<account_ref from the raw file name>": "<account name in Sure>",
    "simplii:chequing": "Everyday Chequing",
    "sunlife:pension": "Workplace Pension"
  },
  "formats": {
    "simplii": {"parser": "simplii"},
    "sunlife": {"parser": "sunlife_pdf"},
    "amex": {
      "parser": "mapped_csv",
      "_unverified": "Amex Canada CSV: column names are a guess (one Amount column, charges positive). Fix from a real export.",
      "date": "Date",
      "description": "Description",
      "amount": "Amount",
      "sign": -1,
      "currency": "CAD"
    }
  }
}
