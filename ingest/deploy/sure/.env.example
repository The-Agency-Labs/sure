# /opt/sure/.env  (chmod 600, owned by root)
SECRET_KEY_BASE=          # openssl rand -hex 64   (keep it forever: encryption keys derive from it)
POSTGRES_PASSWORD=        # openssl rand -hex 24
SURE_BIND_ADDR=127.0.0.1  # with Tailscale Serve in front (recommended); else the VM's tailnet IP. Never the LAN IP or 0.0.0.0
APP_DOMAIN=sure.your-tailnet.ts.net  # the name Serve gives this VM
RAILS_ASSUME_SSL=true     # Serve (or another proxy) terminates TLS
PORT=3000
SURE_IMAGE_TAG=stable     # consider pinning a release tag
BACKUP_DIR=/srv/finance/sure-backups
BACKUP_SCHEDULE=0 */6 * * *
BACKUP_KEEP_DAYS=14
INSTANCE_ID=finance
