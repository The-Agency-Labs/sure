# /opt/sure/.env  (chmod 600, owned by root)
SECRET_KEY_BASE=          # openssl rand -hex 64   (keep it forever: encryption keys derive from it)
POSTGRES_PASSWORD=        # openssl rand -hex 24
SURE_BIND_ADDR=192.0.2.10  # the VM's LAN or tailnet IP; never 0.0.0.0
APP_DOMAIN=sure.example.com
RAILS_ASSUME_SSL=false    # true when a reverse proxy in front terminates TLS
PORT=3000
SURE_IMAGE_TAG=stable     # consider pinning a release tag
BACKUP_DIR=/srv/finance/sure-backups
BACKUP_SCHEDULE=0 */6 * * *
BACKUP_KEEP_DAYS=14
INSTANCE_ID=finance
