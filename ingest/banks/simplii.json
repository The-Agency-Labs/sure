{
  "_notes": [
    "Recorded 2026-11-17 with `ingest record` (real Chrome). Not yet run on the VM.",
    "Unverified until the first VM run: the allowlist's POST patterns and extra hosts",
    "(an unlisted request is aborted in the browser and logged by path shape, so the",
    "first runs reveal them without anything reaching the bank), and the verification",
    "step's input/submit locators. Codes come from the Simplii app; there is no \"remember this device\" box.",
    "Every account in the download dropdown is fetched (for_each_account). Files are named",
    "after the account's label, e.g. no-fee-chequing-1234__<date>.csv; map each name to a",
    "Sure account in ingest.json \"accounts\" as \"simplii:<name>\"."
  ],
  "institution": "simplii",
  "currency": "CAD",
  "allowlist": {
    "navigation": [
      "^https://online\\.simplii\\.com/ebm-resources/public/"
    ],
    "hosts": [
      "online.simplii.com"
    ],
    "post": [
      "^https://online\\.simplii\\.com/ebm-anp/api/v1/json/sessions$"
    ],
    "block": [
      "#/(move-money|pay|send)",
      "upcoming-transactions"
    ]
  },
  "for_each_account": {
    "css": "[data-test-id=\"account-dropdown-select\"]"
  },
  "login": [
    {
      "action": "goto",
      "intent": "open the sign-on page",
      "url": "https://online.simplii.com/ebm-resources/public/simplii/online-banking/client/index.html"
    },
    {
      "action": "dismiss",
      "intent": "accept the cookie banner if shown",
      "locator": {
        "role": "button",
        "name": "Accept all cookies"
      }
    },
    {
      "action": "fill",
      "intent": "enter the card number",
      "locator": {
        "css": "[data-test-id=\"card-number-input\"]"
      },
      "secret": "simplii/username"
    },
    {
      "action": "fill",
      "intent": "enter the password",
      "locator": {
        "css": "[data-test-id=\"password-input\"]"
      },
      "secret": "simplii/password"
    },
    {
      "action": "click",
      "intent": "submit the sign-on form",
      "locator": {
        "css": "[data-test-id=\"primary-button\"]"
      }
    },
    {
      "action": "mfa",
      "intent": "answer a one-time verification code if asked",
      "detect": {
        "css": "[data-test-id*=\"-send-\"]"
      },
      "request": {
        "css": "[data-test-id*=\"-send-\"]"
      },
      "input": {
        "css": "[data-test-id*=\"verification-code\"]"
      },
      "submit": {
        "css": "button[type=\"submit\"]"
      },
      "timeout_ms": 8000
    },
    {
      "action": "expect",
      "intent": "land on the signed-in pages",
      "locator": {
        "css": "[data-test-id=\"olb-extras-download-transactions\"]"
      }
    }
  ],
  "steps": [
    {
      "action": "click",
      "intent": "open download transactions",
      "locator": {
        "css": "[data-test-id=\"olb-extras-download-transactions\"]"
      }
    },
    {
      "action": "select",
      "intent": "choose the next account",
      "locator": {
        "css": "[data-test-id=\"account-dropdown-select\"]"
      },
      "option": "{account}"
    },
    {
      "action": "click",
      "intent": "use the default date range",
      "locator": {
        "css": "[data-test-id=\"display-date-range-input\"]"
      }
    },
    {
      "action": "select",
      "intent": "choose CSV",
      "locator": {
        "css": "[data-test-id=\"software-dropdown-select\"]"
      },
      "option": "CSV"
    },
    {
      "action": "download",
      "intent": "download this account's transactions",
      "locator": {
        "css": "[data-test-id=\"download-transactions-btn\"]"
      },
      "save_as": "{account}__{today}.{ext}",
      "empty": {
        "text": "There are no transactions found that meet your request"
      }
    }
  ]
}
